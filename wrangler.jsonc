{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appsd",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6d440f67-ae51-4812-9488-42b42d809c87","database_name": "web-appsd" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "595891cfff1e4ffc9cc63755345691eb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
